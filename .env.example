# DataSentry configuration. Copy to `.env` -- which is gitignored -- and edit.
#
#   cp .env.example .env
#
# Every line here is optional. With none of them set, DataSentry runs the
# whole loop on the deterministic reasoner and a local SQLite control plane,
# which is what `py ds.py demo` does on a fresh clone.
#
# A variable exported in your shell always beats this file, so a one-off
# override does not mean editing (and later accidentally committing) secrets.

# ---------------------------------------------------------------------------
# Reasoning
# ---------------------------------------------------------------------------
# `auto` resolves groq -> gemini -> heuristic. Free tiers first,
# so setting ONE of the keys below is the entire setup.
#
# Naming a provider explicitly is exact: if its key is missing the run falls
# back to the deterministic reasoner rather than quietly billing another one.
#
#   auto | groq | gemini | heuristic
DS_LLM_PROVIDER=auto

# Groq -- free tier, no card. https://console.groq.com/keys
# Defaults: llama-3.1-8b-instant (cheap) / llama-3.3-70b-versatile (frontier)
GROQ_API_KEY=

# Google Gemini -- free tier, no card. https://aistudio.google.com/apikey
# Defaults: gemini-2.0-flash (cheap) / gemini-2.5-flash (frontier)
GEMINI_API_KEY=

# Pin specific models. Leave empty to use the active provider's defaults --
# you should not have to know Groq's model ids just to try Groq.
# `py ds.py doctor` checks whatever is set against the live catalogue.
DS_LLM_CHEAP_MODEL=
DS_LLM_FRONTIER_MODEL=

# ---------------------------------------------------------------------------
# Serving
# ---------------------------------------------------------------------------
# 0.0.0.0 in a container, 127.0.0.1 locally. PaaS platforms inject their own
# PORT; DS_PORT wins locally so the same image runs unchanged in both places.
DS_HOST=127.0.0.1
DS_PORT=8787

# Comma-separated origins allowed to call the API cross-site. Empty means
# same-origin only, which is correct when one process serves both the console
# and the API -- the default shape. Only set this for a split deployment.
#   DS_CORS_ORIGINS=https://datasentry.example.com
DS_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# SQLite paths. On a platform with an ephemeral filesystem, point these at a
# mounted disk or the database is destroyed on every restart and deploy.
#   DS_DATA_DIR=/data
DS_DATA_DIR=
DS_DB_PATH=
DS_WAREHOUSE_PATH=

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# Salt for the hashed sample values in profiles. Change it in any deployment
# that profiles real data: it is what stops a profile being reversible.
DS_PROFILE_SALT=datasentry-local-salt

# Structured JSON logs instead of the human-readable console format. On in
# any environment with a log aggregator.
DS_LOG_JSON=0

# Seed for the synthetic world, so a demo is reproducible.
DS_SEED=20260829
